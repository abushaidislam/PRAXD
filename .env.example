# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase (public values are safe to expose only as NEXT_PUBLIC; service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub App (server-side only)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=praxd

# Encrypt any credential that must be persisted (use a strong random 32-byte key,
# encoded as base64; prefer a managed KMS/secret store in production).
CREDENTIAL_ENCRYPTION_KEY_BASE64=

# AI provider (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=
AI_REVIEW_MAX_FILES=40
AI_REVIEW_MAX_PATCH_BYTES=500000
AI_REVIEW_MAX_OUTPUT_TOKENS=6000

# Durable background jobs — fill according to the selected provider
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional observability
SENTRY_DSN=
LOG_LEVEL=info
